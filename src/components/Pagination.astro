---
// @ts-check
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import Default from '@astrojs/starlight/components/Pagination.astro';
import PageAuthors from './PageAuthors.astro';

const route: StarlightRouteData = Astro.locals.starlightRoute;
---

<div>
  {/*
    Since the pages file name isn't going to be the id if a slug is defined, used file path and used last part for file name
  */}
  {route.entry && <PageAuthors repo="repooc/repoocreforged-wiki" file={route.entry.id} />}
  <Default />
</div>

<style>
div {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}
</style>
